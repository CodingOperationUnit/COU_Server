# 팀원 공유용 양식: 이 파일을 복사해 .env를 만들고 값을 채우세요 (cp .env.example .env)
DB_PASSWORD=change-me
DB_PORT=3306
JWT_SECRET=change-me-base64-32bytes
REDIS_PORT=6379
# true면 dev API(스태미나 충전, 장비 지급)와 보석 상품 무료 구매가 켜지고, 전투 시간 검증(최소 승리 시간, 시간 비례 상한)이 꺼진다. 로컬 전용, 운영에서는 반드시 false
DEV_TOOLS_ENABLED=false

REDIS_PASSWORD=change-me

# 로그인·회원가입 시도 제한. 비워 두면 기본값 (5회 실패 시 900초 잠금, IP당 60초에 30회)
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_IP_MAX_REQUESTS=30
AUTH_IP_WINDOW_SECONDS=60

# 전투 시간 검증의 배속 한도 (기본 1.0). 정식 배속 기능을 넣으면 최대 배율로 맞춘다
BATTLE_MAX_SPEED_MULTIPLIER=1.0

# HTTPS(Caddy). 운영 EC2에서만 채운다: COMPOSE_PROFILES=https, DOMAIN=xxx.duckdns.org (Docs/Guide/Https.md)
COMPOSE_PROFILES=
DOMAIN=